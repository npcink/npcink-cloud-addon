msgid "Npcink Cloud is not configured."
msgstr "Npcink Cloud 尚未配置。"

#: includes/bootstrap.php:540
msgid "Toolbox runtime payload exceeds the bounded size limit."
msgstr "Toolbox 运行请求超过固定大小限制。"

#: includes/bootstrap.php:554
msgid "Toolbox runtime payload contains fields outside its fixed contract."
msgstr "Toolbox 运行请求包含固定合同之外的字段。"

#: includes/bootstrap.php:562
msgid "Toolbox runtime limits exceed the fixed connector policy."
msgstr "Toolbox 运行限制超出连接器固定策略。"

#: includes/bootstrap.php:584
msgid "Toolbox content support requires its fixed runtime contract."
msgstr "Toolbox 内容支持需要使用其固定运行时合同。"

#: includes/bootstrap.php:608
msgid "Toolbox site helpers require their fixed runtime contract."
msgstr "Toolbox 站点助手需要使用其固定运行时合同。"

#: includes/bootstrap.php:632
msgid "Nightly Inspection requires its fixed runtime contract."
msgstr "夜间检查需要使用其固定运行时合同。"

#: includes/bootstrap.php:900
msgid "Settings"
msgstr "设置"

#: includes/class-cloud-addon-settings.php:227
#: includes/class-cloud-settings-page.php:2011
msgid "Not configured"
msgstr "未配置"

#: includes/class-cloud-addon-settings.php:229
msgid "Cloud settings are incomplete. Reconnect this site in Npcink Cloud to issue a new connection key."
msgstr "Cloud 设置不完整。请在 Npcink Cloud 中重新连接此站点以签发新的连接密钥。"

#: includes/class-cloud-addon-settings.php:230
msgid "Authorize this site in Npcink Cloud to create the connection."
msgstr "在 Npcink Cloud 授权当前站点以创建连接。"

#: includes/class-cloud-addon-settings.php:242
msgid "Verified"
msgstr "已验证"

#: includes/class-cloud-addon-settings.php:243
msgid "Cloud settings are saved and verified."
msgstr "Cloud 设置已保存并通过验证。"

#: includes/class-cloud-addon-settings.php:255
msgid "Connected, activation required"
msgstr "已连接，等待激活"

#: includes/class-cloud-addon-settings.php:256
msgid "This site is bound and its connection credential is stored, but Cloud runtime service is inactive. Activate it in Npcink Cloud, then verify the connection here."
msgstr "此站点已绑定并保存连接凭据，但 Cloud 运行服务尚未激活。请先在 Npcink Cloud 中激活，再回到这里验证连接。"

#: includes/class-cloud-addon-settings.php:267
#: includes/class-cloud-settings-page.php:1906
msgid "Unavailable"
msgstr "不可用"

#: includes/class-cloud-addon-settings.php:267
msgid "Pending verification"
msgstr "等待验证"

#: includes/class-cloud-addon-settings.php:268
msgid "Cloud settings are saved but have not passed verification."
msgstr "Cloud 设置已保存，但尚未通过验证。"

#: includes/class-cloud-addon-settings.php:292
#: includes/class-cloud-settings-page.php:411
#: includes/class-cloud-settings-page.php:428
msgid "Cloud Base URL must use HTTPS unless it points to localhost or 127.0.0.1."
msgstr "Cloud 基础 URL 必须使用 HTTPS，除非指向 localhost 或 127.0.0.1。"

#: includes/class-cloud-addon-settings.php:466
msgid "Cloud verification completed, but the verified state could not be stored securely."
msgstr "Cloud 验证已完成，但无法安全存储已验证状态。"

#: includes/class-cloud-addon-settings.php:684
#: includes/class-cloud-credential-store.php:197
msgid "Cloud credentials could not be stored or read securely. Reconnect this site after checking the WordPress security salts."
msgstr "无法安全存储或读取 Cloud 凭据。请检查 WordPress 安全盐后重新连接此站点。"

#: includes/class-cloud-addon-settings.php:716
msgid "Cloud API Key cannot be empty."
msgstr "Cloud API 密钥不能为空。"

#: includes/class-cloud-addon-settings.php:723
msgid "Manual Cloud API Key recovery must use a Cloud-issued mak1_ wrapper. Reconnect this site in Npcink Cloud to issue a new key."
msgstr "手动恢复 Cloud API 密钥必须使用 Cloud 签发的 mak1_ 封装密钥。请在 Npcink Cloud 中重新连接此站点以签发新密钥。"

#: includes/class-cloud-addon-settings.php:731
msgid "Cloud API Key could not be decoded."
msgstr "无法解码 Cloud API 密钥。"

#: includes/class-cloud-addon-settings.php:739
msgid "Cloud API Key format is invalid. Use a key issued by Npcink Cloud."
msgstr "Cloud API 密钥格式无效。请使用 Npcink Cloud 签发的密钥。"

#: includes/class-cloud-addon-settings.php:750
msgid "Cloud API Key wrapper is missing required signing data."
msgstr "Cloud API 密钥封装缺少必需的签名数据。"

#: includes/class-cloud-entitlement-summary.php:124
#: includes/class-cloud-entitlement-summary.php:167
msgid "Configure Cloud settings before reading entitlement."
msgstr "读取权益信息前请先配置 Cloud 设置。"

#: includes/class-cloud-entitlement-summary.php:130
#: includes/class-cloud-entitlement-summary.php:173
msgid "Entitlement is unavailable until Cloud settings verify successfully."
msgstr "Cloud 设置验证成功前，权益信息不可用。"

#: includes/class-cloud-entitlement-summary.php:185
msgid "The latest Cloud summary is not available yet. Check the connection to try again."
msgstr "暂时无法获取最新的 Cloud 摘要。请检查连接后重试。"

#: includes/class-cloud-entitlement-summary.php:66
#: includes/class-cloud-entitlement-summary.php:205
#: includes/class-cloud-entitlement-summary.php:227
#: includes/class-cloud-settings-page.php:96
#: includes/class-cloud-settings-page.php:164
#: includes/class-cloud-settings-page.php:2944
msgid "Plan and entitlement are temporarily unavailable."
msgstr "暂时无法获取套餐与权益。"

#: includes/class-cloud-entitlement-summary.php:213
msgid "Plan and entitlement are already being refreshed."
msgstr "正在刷新套餐与权益。"

#: includes/class-cloud-entitlement-summary.php:352
msgid "Entitlement summary synced."
msgstr "权益摘要已同步。"

#: includes/class-cloud-media-derivative-transport.php:68
msgid "Source upload and source artifact id cannot be sent together."
msgstr "不能同时发送源文件上传和源 artifact id。"

#: includes/class-cloud-media-derivative-transport.php:96
msgid "Watermark upload and watermark artifact id cannot be sent together."
msgstr "不能同时发送水印上传和水印 artifact id。"

#: includes/class-cloud-media-derivative-transport.php:275
msgid "Cloud media derivative statuses require a data envelope."
msgstr "Cloud 媒体衍生状态需要 data 信封。"

#: includes/class-cloud-media-derivative-transport.php:286
msgid "Cloud media derivative statuses require a run id and canonical lifecycle status."
msgstr "Cloud 媒体衍生状态需要运行 ID 和规范的生命周期状态。"

#: includes/class-cloud-media-derivative-transport.php:403
msgid "Skipped media governance canaries do not publish derivative artifacts."
msgstr "已跳过的媒体治理金丝雀测试不会发布衍生工件。"

#: includes/class-cloud-media-derivative-transport.php:423
msgid "Cloud media derivative results require the exact qualified media_derivative_result.v3 artifact envelope."
msgstr "Cloud 媒体衍生结果需要精确且合格的 media_derivative_result.v3 工件信封。"

#: includes/class-cloud-media-derivative-transport.php:463
msgid "Skipped automatic optimization results require the exact media_derivative_result.v3 decision envelope."
msgstr "已跳过的自动优化结果需要精确的 media_derivative_result.v3 决策信封。"

#: includes/class-cloud-media-derivative-transport.php:494
msgid "Skipped automatic optimization results require bounded decision facts."
msgstr "已跳过的自动优化结果需要受限的决策事实。"

#: includes/class-cloud-media-derivative-transport.php:672
msgid "Cloud media governance canary evidence failed strict validation."
msgstr "Cloud 媒体治理金丝雀测试证据未通过严格验证。"

#: includes/class-cloud-media-derivative-transport.php:836
msgid "Cloud derivative artifact download returned no bytes."
msgstr "Cloud 衍生 artifact 下载未返回内容。"

#: includes/class-cloud-media-derivative-transport.php:846
msgid "Cloud derivative artifact mime type does not match the descriptor."
msgstr "Cloud 衍生 artifact 的 MIME 类型与描述不匹配。"

#: includes/class-cloud-media-derivative-transport.php:855
msgid "Derivative artifact byte size does not match the descriptor and signed response."
msgstr "衍生工件的字节大小与描述符和签名响应不一致。"

#: includes/class-cloud-media-derivative-transport.php:865
msgid "Derivative artifact checksum does not match the downloaded bytes."
msgstr "衍生 artifact 校验和与下载内容不匹配。"

#: includes/class-cloud-media-derivative-transport.php:875
msgid "Signed media response headers do not match the requested artifact."
msgstr "已签名的媒体响应头与请求的工件不一致。"

#: includes/class-cloud-media-derivative-transport.php:891
msgid "Cloud media delivery headers are missing or invalid."
msgstr "Cloud 媒体投递响应头缺失或无效。"

#: includes/class-cloud-media-derivative-transport.php:908
msgid "Derivative artifact decode facts do not match the Cloud descriptor."
msgstr "衍生工件的解码信息与 Cloud 描述符不一致。"

#: includes/class-cloud-media-derivative-transport.php:948
msgid "Cloud media delivery acknowledgement does not bind to the verified transfer."
msgstr "Cloud 媒体投递确认未绑定到已验证的传输。"

#: includes/class-cloud-media-derivative-transport.php:1223
msgid "Npcink Cloud credentials must verify before dispatching media derivative jobs."
msgstr "派发媒体衍生任务前，Npcink Cloud 凭据必须先通过验证。"

#: includes/class-cloud-media-derivative-transport.php:1266
msgid "Local media derivative proposal building requires the exact Addon run-result projection."
msgstr "构建本地媒体衍生提案需要精确的 Addon 运行结果投影。"

#: includes/class-cloud-media-derivative-transport.php:1291
msgid "Media derivative request contract version is invalid."
msgstr "媒体衍生请求的合同版本无效。"

#: includes/class-cloud-media-derivative-transport.php:1298
msgid "Media derivative request must be read-only and proposal-only."
msgstr "媒体衍生请求必须是只读且仅生成提案。"

#: includes/class-cloud-media-derivative-transport.php:1305
msgid "Media derivative final write owner must remain the local WordPress host."
msgstr "媒体衍生的最终写入所有者必须保留为本地 WordPress 主机。"

#: includes/class-cloud-media-derivative-transport.php:1312
msgid "Media derivative request must not include WordPress writes."
msgstr "媒体衍生请求不得包含 WordPress 写入。"

#: includes/class-cloud-media-derivative-transport.php:1319
msgid "Media derivative ability payload must not include credentials or signed headers."
msgstr "媒体衍生 ability payload 不得包含凭据或签名请求头。"

#: includes/class-cloud-media-derivative-transport.php:1328
msgid "Cloud media derivative job type is invalid."
msgstr "Cloud 媒体衍生任务类型无效。"

#: includes/class-cloud-media-derivative-transport.php:1335
msgid "Media derivative jobs must not request original file replacement."
msgstr "媒体衍生任务不得请求替换原始文件。"

#: includes/class-cloud-media-derivative-transport.php:1357
msgid "Media derivative optimization mode is invalid."
msgstr "媒体衍生优化模式无效。"

#: includes/class-cloud-media-derivative-transport.php:1362
msgid "Automatic safe optimization requires the current fixed policy version."
msgstr "自动安全优化需要使用当前固定策略版本。"

#: includes/class-cloud-media-derivative-transport.php:1371
msgid "Watermark artifact transport requires a watermark plan in the ability response."
msgstr "水印 artifact 传输要求 ability response 中包含水印计划。"

#: includes/class-cloud-media-derivative-transport.php:1378
msgid "Text watermark plans must not include a watermark upload or artifact id."
msgstr "文本水印计划不得包含水印上传或 artifact id。"

#: includes/class-cloud-media-derivative-transport.php:1385
msgid "Watermark plans require a watermark upload or artifact id before Cloud dispatch."
msgstr "派发到 Cloud 前，水印计划需要水印上传或 artifact id。"

#: includes/class-cloud-media-derivative-transport.php:1392
msgid "Automatic safe optimization requires WebP output."
msgstr "自动安全优化需要输出 WebP。"

#: includes/class-cloud-media-derivative-transport.php:1397
msgid "Media derivative request must include a bounded target format from the ability response."
msgstr "媒体衍生请求必须包含 ability response 提供的受限目标格式。"

#: includes/class-cloud-media-derivative-transport.php:1406
msgid "Media derivative request must include max_width from the ability response."
msgstr "媒体衍生请求必须包含 ability response 中的 max_width。"

#: includes/class-cloud-media-derivative-transport.php:1415
msgid "Media derivative request must include quality from the ability response."
msgstr "媒体衍生请求必须包含 ability response 中的 quality。"

#: includes/class-cloud-media-derivative-transport.php:1428
msgid "Media derivative resize mode is invalid."
msgstr "媒体衍生缩放模式无效。"

#: includes/class-cloud-media-derivative-transport.php:1433
msgid "Automatic safe optimization does not accept quality, crop, watermark, or custom width parameters."
msgstr "自动安全优化不接受质量、裁剪、水印或自定义宽度参数。"

#: includes/class-cloud-media-derivative-transport.php:1447
msgid "Media derivative source media type must be a supported image type."
msgstr "媒体衍生源媒体类型必须是受支持的图片类型。"

#: includes/class-cloud-media-derivative-transport.php:1485
msgid "Media governance canaries require exact governance and batch context fields."
msgstr "媒体治理金丝雀测试需要准确的治理和批次上下文字段。"

#: includes/class-cloud-media-derivative-transport.php:1525
msgid "Media governance canaries require WebP preserve previews, no crop or watermark, and at most ten items."
msgstr "媒体治理金丝雀测试要求生成保留原尺寸的 WebP 预览，不得裁剪或添加水印，且最多包含十项。"

#: includes/class-cloud-media-derivative-transport.php:1577
msgid "Media derivative jobs require a canonical source artifact id."
msgstr "媒体衍生任务需要规范的源工件 ID。"

#: includes/class-cloud-media-derivative-transport.php:1592
msgid "Media derivative image watermarks require a canonical artifact id."
msgstr "媒体衍生图像水印需要规范的工件 ID。"

#: includes/class-cloud-media-derivative-transport.php:1736
msgid "Media upload descriptors contain an unknown field."
msgstr "媒体上传描述符包含未知字段。"

#: includes/class-cloud-media-derivative-transport.php:1747
msgid "Media upload descriptors require exactly one byte source."
msgstr "媒体上传描述符必须且只能包含一个字节来源。"

#: includes/class-cloud-media-derivative-transport.php:1769
#: includes/class-cloud-media-derivative-transport.php:1777
msgid "Media derivative upload file is not readable."
msgstr "媒体衍生上传文件不可读。"

#: includes/class-cloud-media-derivative-transport.php:1784
msgid "Media derivative upload files must come from the WordPress uploads directory or a local temporary directory."
msgstr "Media derivative 上传文件必须来自 WordPress uploads 目录或本地临时目录。"

#: includes/class-cloud-media-derivative-transport.php:1792
#: includes/class-cloud-media-derivative-transport.php:1810
msgid "Media derivative upload file exceeds the Cloud size limit."
msgstr "媒体衍生上传文件超过 Cloud 大小限制。"

#: includes/class-cloud-media-derivative-transport.php:1803
msgid "Media derivative upload file is empty."
msgstr "媒体衍生上传文件为空。"

#: includes/class-cloud-media-derivative-transport.php:1819
msgid "Media derivative uploads require an allowed image mime type."
msgstr "媒体衍生上传需要允许的图像 MIME 类型。"

#: includes/class-cloud-media-derivative-transport.php:1831
msgid "Media derivative upload bytes do not match the declared image mime type."
msgstr "媒体衍生上传字节与声明的图像 MIME 类型不一致。"

#: includes/class-cloud-media-derivative-transport.php:1844
msgid "Media derivative upload dimensions exceed the local image limits."
msgstr "媒体衍生上传尺寸超出本地图像限制。"

#: includes/class-cloud-media-derivative-transport.php:1913
msgid "Legacy media upload descriptor fields are not accepted."
msgstr "不接受旧版媒体上传描述符字段。"

#: includes/class-cloud-media-derivative-transport.php:1948
msgid "Media derivative runtime artifacts require a canonical artifact id."
msgstr "媒体衍生运行时工件需要规范的工件 ID。"

#: includes/class-cloud-media-derivative-transport.php:1955
msgid "Media derivative runtime artifacts require a valid future expiry."
msgstr "媒体衍生运行时工件需要有效的未来过期时间。"

#: includes/class-cloud-media-derivative-transport.php:1998
msgid "Media derivative artifacts require the exact 13-field Cloud descriptor."
msgstr "媒体衍生工件需要精确的 13 字段 Cloud 描述符。"

#: includes/class-cloud-media-derivative-transport.php:2007
msgid "Media derivative artifact expiry must be a strict ISO-8601 timestamp."
msgstr "媒体衍生工件过期时间必须是严格的 ISO-8601 时间戳。"

#: includes/class-cloud-media-derivative-transport.php:2014
msgid "Expired Cloud artifacts cannot be adopted."
msgstr "已过期的 Cloud artifact 不能被采用。"

#: includes/class-cloud-media-derivative-transport.php:2023
msgid "Derivative Cloud artifacts require a canonical artifact id."
msgstr "Cloud 衍生工件需要规范的工件 ID。"

#: includes/class-cloud-media-derivative-transport.php:2031
msgid "Media derivative artifact reference must bind to the canonical artifact id."
msgstr "媒体衍生工件引用必须绑定到规范的工件 ID。"

#: includes/class-cloud-media-derivative-transport.php:2047
msgid "Media derivative filename basis is invalid."
msgstr "媒体衍生文件名依据无效。"

#: includes/class-cloud-media-derivative-transport.php:2055
msgid "Media derivative suggested filename is invalid."
msgstr "媒体衍生建议文件名无效。"

#: includes/class-cloud-media-derivative-transport.php:2071
msgid "Media derivative artifact MIME and format must agree."
msgstr "媒体衍生工件的 MIME 类型与格式必须一致。"

#: includes/class-cloud-media-derivative-transport.php:2092
msgid "Media derivative artifact facts are invalid."
msgstr "媒体衍生工件信息无效。"

#: includes/class-cloud-media-derivative-transport.php:2100
msgid "Media derivative processing warnings are invalid."
msgstr "媒体衍生处理警告无效。"

#: includes/class-cloud-media-derivative-transport.php:2174
msgid "Local media derivative artifacts require the exact 12-field proposal contract."
msgstr "本地媒体衍生工件需要精确的 12 字段提案契约。"

#: includes/class-cloud-media-derivative-transport.php:2204
msgid "Local media derivative artifact facts are invalid."
msgstr "本地媒体衍生工件信息无效。"

#: includes/class-cloud-media-derivative-transport.php:2228
msgid "Local media derivative artifact metadata is invalid."
msgstr "本地媒体衍生工件元数据无效。"

#: includes/class-cloud-media-derivative-transport.php:2236
msgid "Local media derivative processing warnings are invalid."
msgstr "本地媒体衍生处理警告无效。"

#: includes/class-cloud-media-derivative-transport.php:2386
msgid "Derivative artifact facts do not match the Cloud result."
msgstr "衍生工件信息与 Cloud 结果不一致。"

#: includes/class-cloud-media-derivative-transport.php:2394
msgid "Derivative artifact checksum does not match the Cloud result."
msgstr "衍生 artifact 校验和与 Cloud 结果不匹配。"

#: includes/class-cloud-media-derivative-transport.php:2412
msgid "Original media metrics are incomplete."
msgstr "原始媒体指标不完整。"

#: includes/class-cloud-media-derivative-transport.php:2415
msgid "Derivative media metrics are incomplete."
msgstr "衍生媒体指标不完整。"

#: includes/class-cloud-observability-collector.php:104
#: includes/class-cloud-observability-collector.php:233
msgid "Monitoring is disabled or Cloud is not verified."
msgstr "监控已禁用，或 Cloud 尚未验证。"

#: includes/class-cloud-observability-collector.php:159
#: includes/class-cloud-observability-collector.php:254
#: includes/class-cloud-settings-page.php:587
#: includes/class-cloud-site-knowledge-admin-actions.php:26
#: includes/class-cloud-site-knowledge-admin-actions.php:68
#: includes/class-cloud-site-knowledge-admin-actions.php:97
#: includes/class-cloud-site-knowledge-change-bridge.php:419
#: includes/class-cloud-site-knowledge-change-bridge.php:463
msgid "Cloud Addon settings are not verified."
msgstr "Cloud Addon 设置尚未验证。"

#: includes/class-cloud-observability-collector.php:183
msgid "Cloud did not accept the monitoring state projection."
msgstr "Cloud 未接受监控状态投影。"

#: includes/class-cloud-observability-collector.php:1160
msgid "Core"
msgstr "治理核心"

#: includes/class-cloud-observability-collector.php:1165
msgid "Abilities"
msgstr "原子能力"

#: includes/class-cloud-observability-collector.php:1170
msgid "Adapter"
msgstr "渠道适配器"

#: includes/class-cloud-observability-collector.php:1175
#: includes/class-cloud-settings-page.php:224
#: includes/class-cloud-settings-page.php:2017
msgid "Cloud Addon"
msgstr "云端扩展"

#: includes/class-cloud-outbound-policy.php:99
msgid "Cloud returned an unexpected response type."
msgstr "Cloud 返回了意外的响应类型。"

#: includes/class-cloud-outbound-policy.php:154
msgid "Cloud response exceeds the local size limit."
msgstr "Cloud 响应超出本地大小限制。"

#: includes/class-cloud-outbound-policy.php:409
msgid "Cloud request target is not allowed by the local connector policy."
msgstr "本地连接器策略不允许此 Cloud 请求目标。"

