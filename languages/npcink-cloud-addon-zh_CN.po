#. Description of the plugin
#: npcink-cloud-addon.php
msgid "Cloud connector for Npcink hosted runtime access, signing, health checks, and entitlement summaries."
msgstr "用于 Npcink 托管运行时访问、签名、健康检查和权益摘要的 Cloud 连接器。"

#. Author of the plugin
#: npcink-cloud-addon.php
msgid "Npcink"
msgstr "Npcink"

#: includes/class-cloud-addon-settings.php:227
#: includes/class-cloud-settings-page.php:2506
msgid "Not configured"
msgstr "未配置"

#: includes/class-cloud-addon-settings.php:242
msgid "Verified"
msgstr "已验证"

#: includes/class-cloud-addon-settings.php:243
msgid "Cloud settings are saved and verified."
msgstr "Cloud 设置已保存并通过验证。"

#: includes/class-cloud-addon-settings.php:684
#: includes/class-cloud-credential-store.php:197
msgid "Cloud credentials could not be stored or read securely. Reconnect this site after checking the WordPress security salts."
msgstr "无法安全存储或读取 Cloud 凭据。请检查 WordPress 安全盐后重新连接此站点。"

#: includes/class-cloud-addon-settings.php:255
msgid "Connected, activation required"
msgstr "已连接，等待激活"

#: includes/class-cloud-addon-settings.php:256
msgid "This site is bound and its connection credential is stored, but Cloud runtime service is inactive. Activate it in Npcink Cloud, then verify the connection here."
msgstr "此站点已绑定并保存连接凭据，但 Cloud 运行服务尚未激活。请先在 Npcink Cloud 中激活，再回到这里验证连接。"

#: includes/class-cloud-settings-page.php:425
#: includes/class-cloud-settings-page.php:536
#: includes/class-cloud-settings-page.php:552
msgid "Cloud credentials could not be stored securely. The existing connection was not changed. Check the WordPress security salts and reconnect."
msgstr "无法安全存储 Cloud 凭据。现有连接未更改。请检查 WordPress 安全盐并重新连接。"

#: includes/class-cloud-addon-settings.php:267
msgid "Unavailable"
msgstr "不可用"

#: includes/class-cloud-addon-settings.php:267
msgid "Pending verification"
msgstr "等待验证"

#: includes/class-cloud-addon-settings.php:268
msgid "Cloud settings are saved but have not passed verification."
msgstr "Cloud 设置已保存，但尚未通过验证。"

#: includes/class-cloud-addon-settings.php:292
#: includes/class-cloud-settings-page.php:489
#: includes/class-cloud-settings-page.php:506
msgid "Cloud Base URL must use HTTPS unless it points to localhost or 127.0.0.1."
msgstr "Cloud 基础 URL 必须使用 HTTPS，除非指向 localhost 或 127.0.0.1。"

#: includes/class-cloud-addon-settings.php:716
msgid "Cloud API Key cannot be empty."
msgstr "Cloud API 密钥不能为空。"

#: includes/class-cloud-addon-settings.php:731
msgid "Cloud API Key could not be decoded."
msgstr "无法解码 Cloud API 密钥。"

#: includes/class-cloud-addon-settings.php:739
msgid "Cloud API Key format is invalid. Use a key issued by Npcink Cloud."
msgstr "Cloud API 密钥格式无效。请使用 Npcink Cloud 签发的密钥。"

#: includes/class-cloud-entitlement-summary.php:35
#: includes/class-cloud-entitlement-summary.php:77
msgid "Configure Cloud settings before reading entitlement."
msgstr "读取权益信息前请先配置 Cloud 设置。"

#: includes/class-cloud-entitlement-summary.php:41
#: includes/class-cloud-entitlement-summary.php:83
msgid "Entitlement is unavailable until Cloud settings verify successfully."
msgstr "Cloud 设置验证成功前，权益信息不可用。"

#: includes/class-cloud-entitlement-summary.php:262
msgid "Entitlement summary synced."
msgstr "权益摘要已同步。"

#: includes/class-cloud-media-derivative-transport.php:62
msgid "Source upload and source artifact id cannot be sent together."
msgstr "不能同时发送源文件上传和源 artifact id。"

#: includes/class-cloud-media-derivative-transport.php:90
msgid "Watermark upload and watermark artifact id cannot be sent together."
msgstr "不能同时发送水印上传和水印 artifact id。"

#: includes/class-cloud-media-derivative-transport.php:540
msgid "Cloud derivative artifact download returned no bytes."
msgstr "Cloud 衍生 artifact 下载未返回内容。"

#: includes/class-cloud-media-derivative-transport.php:550
msgid "Cloud derivative artifact mime type does not match the descriptor."
msgstr "Cloud 衍生 artifact 的 MIME 类型与描述不匹配。"

#: includes/class-cloud-media-derivative-transport.php:569
msgid "Derivative artifact checksum does not match the downloaded bytes."
msgstr "衍生 artifact 校验和与下载内容不匹配。"

#: includes/class-cloud-media-derivative-transport.php:927
msgid "Npcink Cloud credentials must verify before dispatching media derivative jobs."
msgstr "派发媒体衍生任务前，Npcink Cloud 凭据必须先通过验证。"

#: includes/class-cloud-media-derivative-transport.php:989
msgid "Media derivative request contract version is invalid."
msgstr "媒体衍生请求的合同版本无效。"

#: includes/class-cloud-media-derivative-transport.php:996
msgid "Media derivative request must be read-only and proposal-only."
msgstr "媒体衍生请求必须是只读且仅生成提案。"

#: includes/class-cloud-media-derivative-transport.php:1003
msgid "Media derivative final write owner must remain the local WordPress host."
msgstr "媒体衍生的最终写入所有者必须保留为本地 WordPress 主机。"

#: includes/class-cloud-media-derivative-transport.php:1010
msgid "Media derivative request must not include WordPress writes."
msgstr "媒体衍生请求不得包含 WordPress 写入。"

#: includes/class-cloud-media-derivative-transport.php:1017
msgid "Media derivative ability payload must not include credentials or signed headers."
msgstr "媒体衍生 ability payload 不得包含凭据或签名请求头。"

#: includes/class-cloud-media-derivative-transport.php:1026
msgid "Cloud media derivative job type is invalid."
msgstr "Cloud 媒体衍生任务类型无效。"

#: includes/class-cloud-media-derivative-transport.php:1033
msgid "Media derivative jobs must not request original file replacement."
msgstr "媒体衍生任务不得请求替换原始文件。"

#: includes/class-cloud-media-derivative-transport.php:1060
msgid "Watermark artifact transport requires a watermark plan in the ability response."
msgstr "水印 artifact 传输要求 ability response 中包含水印计划。"

#: includes/class-cloud-media-derivative-transport.php:1067
msgid "Text watermark plans must not include a watermark upload or artifact id."
msgstr "文本水印计划不得包含水印上传或 artifact id。"

#: includes/class-cloud-media-derivative-transport.php:1074
msgid "Watermark plans require a watermark upload or artifact id before Cloud dispatch."
msgstr "派发到 Cloud 前，水印计划需要水印上传或 artifact id。"

#: includes/class-cloud-media-derivative-transport.php:1083
msgid "Media derivative request must include a bounded target format from the ability response."
msgstr "媒体衍生请求必须包含 ability response 提供的受限目标格式。"

#: includes/class-cloud-media-derivative-transport.php:1092
msgid "Media derivative request must include max_width from the ability response."
msgstr "媒体衍生请求必须包含 ability response 中的 max_width。"

#: includes/class-cloud-media-derivative-transport.php:1101
msgid "Media derivative request must include quality from the ability response."
msgstr "媒体衍生请求必须包含 ability response 中的 quality。"

#: includes/class-cloud-media-derivative-transport.php:1117
msgid "Media derivative source media type must be a supported image type."
msgstr "媒体衍生源媒体类型必须是受支持的图片类型。"

#: includes/class-cloud-media-derivative-transport.php:1333
#: includes/class-cloud-media-derivative-transport.php:1341
msgid "Media derivative upload file is not readable."
msgstr "媒体衍生上传文件不可读。"

#: includes/class-cloud-media-derivative-transport.php:1356
#: includes/class-cloud-media-derivative-transport.php:1374
msgid "Media derivative upload file exceeds the Cloud size limit."
msgstr "媒体衍生上传文件超过 Cloud 大小限制。"

#: includes/class-cloud-media-derivative-transport.php:1367
msgid "Media derivative upload file is empty."
msgstr "媒体衍生上传文件为空。"

#: includes/class-cloud-media-derivative-transport.php:1577
msgid "Expired Cloud artifacts cannot be adopted."
msgstr "已过期的 Cloud artifact 不能被采用。"

#: includes/class-cloud-media-derivative-transport.php:1949
msgid "Derivative artifact checksum does not match the Cloud result."
msgstr "衍生 artifact 校验和与 Cloud 结果不匹配。"

#: includes/class-cloud-media-derivative-transport.php:1967
msgid "Original media metrics are incomplete."
msgstr "原始媒体指标不完整。"

#: includes/class-cloud-media-derivative-transport.php:1970
msgid "Derivative media metrics are incomplete."
msgstr "衍生媒体指标不完整。"

